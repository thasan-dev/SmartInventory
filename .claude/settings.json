{
  "permissions": {
    "allow": [
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(dotnet build*)",
      "Bash(dotnet restore*)",
      "Bash(ls:*)",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Read"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/backend/.claude/hooks/block-dangerous-bash.sh\"",
            "statusMessage": "Checking command safety..."
          }
        ]
      }
    ]
  }
}